<!-- Admin product creation form -->
<div class="form-card">

  <form action="/admin/add" method="POST" enctype="multipart/form-data">

    <div class="form-group">
      <label>Product Name</label>
      <input type="text" name="name" placeholder="e.g. Luxury Lawn 3-Piece" required />
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Price (Rs.)</label>
        <input type="number" name="price" placeholder="e.g. 4500" required />
      </div>
      <div class="form-group">
        <label>Stock</label>
        <input type="number" name="stock" placeholder="e.g. 50" required />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label>Category</label>
        <select name="category" required>
          <option value="">Select Category</option>
          <option value="Lawn 3-Piece">Lawn 3-Piece</option>
          <option value="Lawn 2-Piece">Lawn 2-Piece</option>
          <option value="Cotton Shirt">Cotton Shirt</option>
          <option value="Lawn Kurti">Lawn Kurti</option>
          <option value="Silk Shirt">Silk Shirt</option>
          <option value="Suit Set">Suit Set</option>
          <option value="Cotton 3-Piece">Cotton 3-Piece</option>
          <option value="Cotton Kurta">Cotton Kurta</option>
        </select>
      </div>
      <div class="form-group">
        <label>Rating</label>
        <input type="number" name="rating" placeholder="e.g. 4.5" 
               min="1" max="5" step="0.1" required />
      </div>
    </div>

    <div class="form-group">
      <label>Product Image</label>
      <input type="file" name="image" accept="image/*" />
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-black">ADD PRODUCT</button>
      <a href="/admin" class="btn btn-white">CANCEL</a>
    </div>

  </form>

</div>