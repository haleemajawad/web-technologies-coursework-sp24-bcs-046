<!-- Admin layout template used by all backend admin pages -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel | Sapphire</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>

  <!-- SIDEBAR -->
  <div class="sidebar">
    <div class="sidebar-logo">SAPPHIRE</div>

    <div class="sidebar-label">MAIN MENU</div>
    <nav>
      <a href="/admin" class="<%= locals.page === 'dashboard' ? 'active' : '' %>">
        📦 Dashboard
      </a>
      <a href="/admin/add" class="<%= locals.page === 'add' ? 'active' : '' %>">
        ➕ Add Product
      </a>
    </nav>

    <div class="sidebar-bottom">
      <a href="/">← Back to Store</a>
    </div>
  </div>

  <!-- MAIN -->
  <div class="main">

    <div class="topbar">
      <h1>
        <% if (locals.page === 'dashboard') { %>Dashboard
        <% } else if (locals.page === 'add') { %>Add Product
        <% } else if (locals.page === 'edit') { %>Edit Product
        <% } else { %>Admin Panel<% } %>
      </h1>
      <div class="topbar-right">Sapphire Admin</div>
    </div>

    <div class="content">
      <%- body %>
    </div>

  </div>

</body>
</html>